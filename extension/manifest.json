{
  "manifest_version": 3,
  "name": "TUWEL Auto 2FA",
  "version": "1.0.0",
  "description": "Automatically fills the Multi-Factor Authentication code for TUWEL login",
  "browser_specific_settings": {
    "gecko": {
      "id": "tuwel-auto-2fa@tuwel.app",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://idp.zid.tuwien.ac.at/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://idp.zid.tuwien.ac.at/*"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TUWEL Auto 2FA",
    "default_icon": "icons/icon.svg"
  },
  "icons": {
    "48": "icons/icon.svg"
  }
}
