{
  "manifest_version": 3,
  "name": "TU Wien Auto 2FA",
  "version": "1.1.0",
  "description": "Automatically fills the Multi-Factor Authentication code for TU Wien login",
  "browser_specific_settings": {
    "gecko": {
      "id": "tuwien-auto-2fa@aGreatTUWienStudent",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://idp.zid.tuwien.ac.at/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://idp.zid.tuwien.ac.at/*"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TU Wien Auto 2FA",
    "default_icon": "icons/icon.svg"
  },
  "icons": {
    "48": "icons/icon.svg"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; object-src 'none'; frame-src 'none'; form-action 'none'; base-uri 'none'"
  }
}
