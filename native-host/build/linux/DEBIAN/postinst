#!/bin/bash
# postinst: files are in place. We deliberately do NOT write the native
# messaging manifest here, because dpkg runs maintainer scripts as root
# with HOME=/root, which would place the manifest in /root/.mozilla
# instead of the actual user's home.
#
# The user simply launches "TU Wien 2FA" once from their app menu; the
# launcher (launcher.sh) writes the manifest for their own $HOME.
set -e

echo "AutoTISS2FA installed."
echo "Launch 'TU Wien 2FA' from your application menu to register it with Firefox."

exit 0