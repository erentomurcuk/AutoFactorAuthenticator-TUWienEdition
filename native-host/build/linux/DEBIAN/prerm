#!/bin/bash
# Called as root by dpkg: $HOME is /root, so the manifest we can remove here
# only exists if the user ran the launcher AS root (rare). The user's real
# manifest lives in their own home — the launcher's uninstall path (+ this
# script when $HOME happens to match) removes it.
# The keychain entry lives in the user's session, so --delete-credential is
# best-effort: it typically fails under root, which is fine. The host also
# clears the pre-rename keychain entry itself.
rm -f "$HOME/.mozilla/native-messaging-hosts/com.autofactor.autotiss2fa.json" 2>/dev/null || true
/opt/autotiss2fa/autotiss2fa-native --delete-credential 2>/dev/null || true
exit 0
